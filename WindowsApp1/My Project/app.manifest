<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MyApplication.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- التطبيق لا يطلب صلاحيات مسؤول: كل ما يحتاج الكتابة فيه يقع في مجلدات البيانات
             التي يمنحها المثبّت صلاحية تعديل للمستخدمين، والتحديث يرفع الصلاحية عند الحاجة فقط. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- الإعلان عن أنظمة التشغيل المدعومة: بدونه يعمل البرنامج في وضع توافق ويندوز 8
           ولا يظهر رقم الإصدار الحقيقي للنظام في واجهات ويندوز. -->
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- دقة الشاشة: System DPI Aware.
       اختير "system" عن قصد بدل PerMonitorV2: مصمّمات هذه الشاشات تعتمد إحداثيات مطلقة،
       وإعادة التحجيم الديناميكي عند نقل النافذة بين شاشتين مختلفتي الدقة يكسر التخطيط.
       "system" يمنع التشويش على شاشات 125%/150%/200% وهو السلوك المستقر هنا. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">system</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <!-- مظهر عناصر التحكم الشائعة: تفعيل الإصدار 6 يجعل صناديق الحوار القياسية
       (فتح/حفظ ملف، MessageBox، قوائم السياق) تظهر بمظهر ويندوز الحديث بدل مظهر
       ويندوز القديم المسطّح. كان هذا القسم معطّلاً بالتعليق فتظهر بعض النوافذ
       بشكل غير متناسق مع باقي البرنامج. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"
        />
    </dependentAssembly>
  </dependency>

</assembly>
