# SECURITY / PRIVACY: database dumps. Never commit a database export — it contains
# real customer, employee, invoice and treasury data. Schema-only scripts live in
# WindowsApp1/Resources/DatabaseSchema.sql and are the only DB scripts that may ship.
*.sql.bak
SestamkDB_*.sql
*_Full.sql
data_export*.sql

